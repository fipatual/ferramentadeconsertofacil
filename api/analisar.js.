// Função do Vercel: recebe a foto do app, chama a Anthropic com a chave guardada no servidor
// (variável de ambiente ANTHROPIC_API_KEY) e devolve a resposta. A chave nunca vai para o navegador.

const MODEL = 'claude-sonnet-5-5';   // modelo fixo: quem chama não consegue trocar
const MAX_TOKENS = 2500;             // tamanho máximo da resposta (controla o custo)
const MAX_PROMPT = 6000;             // caracteres
const MAX_IMAGE = 3_000_000;         // ~2,2 MB de foto em base64
const PER_HOUR = 20;                 // análises por pessoa (IP) por hora

// Limite simples por IP. Fica na memória de cada instância do servidor, então é uma
// proteção básica, não uma garantia: o limite de gastos no Console da Anthropic é a rede de segurança.
const hits = new Map();
function tooMany(ip) {
  const now = Date.now(), hour = 3600_000;
  const list = (hits.get(ip) || []).filter(t => now - t < hour);
  list.push(now);
  hits.set(ip, list);
  if (hits.size > 5000) hits.clear();
  return list.length > PER_HOUR;
}

module.exports = async (req, res) => {
  if (req.method !== 'POST') return res.status(405).json({ error: 'method' });

  const key = process.env.ANTHROPIC_API_KEY;
  if (!key) return res.status(500).json({ error: 'server_not_configured' });

  const ip = String(req.headers['x-forwarded-for'] || '').split(',')[0].trim() || 'unknown';
  if (tooMany(ip)) return res.status(429).json({ error: 'rate_limited' });

  const { prompt, image } = req.body || {};
  if (typeof prompt !== 'string' || typeof image !== 'string' ||
      !prompt.startsWith('You are an experienced home-repair technician') ||
      prompt.length > MAX_PROMPT || image.length > MAX_IMAGE) {
    return res.status(400).json({ error: 'bad_request' });
  }

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model: MODEL,
        max_tokens: MAX_TOKENS,
        messages: [{ role: 'user', content: [
          { type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: image } },
          { type: 'text', text: prompt }
        ] }]
      })
    });
    const data = await r.json();
    if (!r.ok) {
      // 401/403 aqui significa problema na chave do servidor, não do usuário
      const status = (r.status === 401 || r.status === 403) ? 500 : r.status;
      return res.status(status).json({ error: 'upstream', status: r.status });
    }
    return res.status(200).json({ content: data.content });
  } catch (e) {
    return res.status(502).json({ error: 'upstream_failed' });
  }
};

